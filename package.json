{
  "name": "@bjankord/style-guide-boilerplate",
  "version": "3.3.2",
  "description": "A Vite plugin for crafting living style guides from HTML examples and Markdown docs.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "default": "./src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "default": "./src/jsx-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean:types": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\"",
    "build:types": "npm run clean:types && tsc -p tsconfig.json",
    "fixture:dev": "vite test/fixture",
    "fixture:build": "vite build test/fixture",
    "prepack": "npm run build:types",
    "release:major": "npm test && npm version major -m \"Released version %s\" && npm publish --access=public && git push --follow-tags",
    "release:minor": "npm test && npm version minor -m \"Released version %s\" && npm publish --access=public && git push --follow-tags",
    "release:patch": "npm test && npm version patch -m \"Released version %s\" && npm publish --access=public && git push --follow-tags"
  },
  "keywords": [
    "style-guide",
    "styleguide",
    "living-style-guide",
    "pattern-library",
    "vite-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjankord/style-guide-boilerplate.git"
  },
  "author": "Brett Jankord",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bjankord/style-guide-boilerplate/issues"
  },
  "homepage": "https://github.com/bjankord/style-guide-boilerplate#readme",
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@shikijs/rehype": "^4.5.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.2",
    "remark-frontmatter": "^5.0.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
