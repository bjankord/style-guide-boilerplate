---
import fs from 'node:fs';
import path from 'node:path';

const baseDir = new URL(`../../docs/base`, import.meta.url);
const basePath = path.resolve(baseDir.pathname);

const componentsDir = new URL(`../../docs/components`, import.meta.url);
const componentsPath = path.resolve(componentsDir.pathname);

const directories = (dirPath) => fs
  .readdirSync(dirPath, { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .map((entry) => entry.name);

const baseDirectories = directories(basePath);
const componentDirectories = directories(componentsPath);


---
<div id="nav" class="sg-sidebar" role="navigation">
  <h2 class="sg-h2 sg-subnav-title">About</h2>
  <ul class="sg-nav-group">
    <li>
      <a href="#sg-about">Getting Started</a>
    </li>
    <li>
      <a href="#sg-colors">Colors</a>
    </li>
    <li>
      <a href="#sg-fontStacks">Fonts</a>
    </li>
  </ul>

  <ul class="sg-nav-group">
    <li class="sg-subnav-parent">
      <h2 id="sg-base" class="sg-h2 sg-title">Base</h2>
      <ul class="sg-nav-group">
          {baseDirectories.map((dir: any) => {
          const id = `sg-base-${dir.toLowerCase()}`;
          return (
            <li key={id}>
              <a href={`#${id}`}>{dir}</a>
            </li>
          );
        })}
      </ul>
    </li>
  </ul>

  <ul class="sg-nav-group">
    <li class="sg-subnav-parent">
      <h2 id="sg-components" class="sg-h2 sg-title">Components</h2>
      <ul class="sg-nav-group">
          {componentDirectories.map((dir: any) => {
          const id = `sg-components-${dir.toLowerCase()}`;
          return (
            <li key={id}>
              <a href={`#${id}`}>{dir}</a>
            </li>
          );
        })}
      </ul>
    </li>
  </ul>
</div>

<style>
.sg-sidebar {
  padding-top: 1.5rem;
  padding-bottom: 1rem;
}

.sg-sidebar {
  background: #3d3d3d;
  color: #fff;
  font-size: 80%;
  padding-left: 1rem;
  padding-right: 1rem;
}
</style>

<style is:global>
.sg-sidebar {
  opacity: 0;
  position: absolute;
  top: -100%;
  transition: opacity 0.6s ease-out;
}

html:has(input#menu-toggle:checked) .sg-sidebar {
  opacity: 1;
  position: static;
}

@media screen and (min-width: 1025px) {
  .sg-sidebar {
    bottom: 0;
    float: left;
    font-size: 100%;
    opacity: 1;
    position: absolute;
    top: 0;
    width: 25%;
  }
}
</style>