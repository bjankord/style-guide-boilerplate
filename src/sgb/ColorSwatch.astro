<style
define:vars={{ swatchColor: swatchColor }}>
.sgb-cs-swatch {
  background-color: var(--swatchColor);
  border-radius: 5px;
  min-height: 6.250rem;
}

.sgb-cs-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.sgb-cs-info {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.sgb-cs-color-name {
  font-size: 1.15rem;
  font-weight: 700;
}

.sgb-cs-contrast-toggle {
  border: 0;
  font: inherit;
  background: transparent;
  cursor: pointer;
}

.sgb-cs-visually-hidden {
  border: 0;
  clip: rect(0 0 0 0);
  height: 1px;
  margin: -1px;
  overflow: hidden;
  padding: 0;
  position: absolute;
  width: 1px;
}
</style>
